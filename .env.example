# =============================================================================
# 类人情感记忆系统 — 模型接入配置示例 (.env.example)
# -----------------------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env（或直接设置同名系统环境变量）；
#   2. 在 config/model.json 中按 provider 名登记即可路由到对应适配器；
#   3. 适配器经 resolve_api_key() 读取：provider 专属变量优先，
#      其次通用 EMOTION_LLM_API_KEY / OPENAI_API_KEY，最后回退配置。
#
# 安全约定：严禁在本文件提交真实密钥；此处仅作键名与格式示例。
# 本地端点（Ollama / LM Studio / llama.cpp）无需密钥，可留空。
# =============================================================================

# ---------------------- 通用（兜底） ----------------------
# 未设置各 provider 专属变量时，可统一使用：
# EMOTION_LLM_API_KEY=your-key-here
# OPENAI_API_KEY=your-openai-key-here

# ---------------------- OpenAI 兼容全家 ----------------------
# 一个适配器 OpenAICompatAdapter，靠 base_url + model + headers 区分各家。
OPENAI_API_KEY=sk-xxx
DEEPSEEK_API_KEY=sk-xxx                       # DeepSeek
DASHSCOPE_API_KEY=sk-xxx                      # 通义 Qwen（DashScope 兼容模式）
MOONSHOT_API_KEY=sk-xxx                       # Kimi Moonshot
ZHIPUAI_API_KEY=xxx.xxxx                      # 智谱 GLM
MINIMAX_API_KEY=xxx                           # MiniMax
ARK_API_KEY=xxx                               # 豆包 / 火山方舟
QIANFAN_API_KEY=xxx                           # 文心千帆（兼容模式）

# ---------------------- Anthropic (Claude) ----------------------
# 鉴权头：x-api-key + anthropic-version（默认 2023-06-01，可用
# profile["anthropic_version"] 覆盖）。
ANTHROPIC_API_KEY=sk-ant-xxx

# ---------------------- Google Gemini ----------------------
# 鉴权头：x-goog-api-key。嵌入默认模型 text-embedding-004，
# 可用 profile["embed_model"] 覆盖。
GEMINI_API_KEY=AIza-xxx

# ---------------------- 本地模型（无需密钥） ----------------------
# local_compat 适配器：Ollama / LM Studio / llama.cpp server，
# 均为 OpenAI 兼容端点，默认 http://localhost:11434/v1。
# 轻鉴权场景（如 llama.cpp server）用 profile["headers"] 透传：
#   {"Authorization": "Bearer xxx"}

# =============================================================================
# Provider 对照表（provider 名 → 默认端点 / 默认模型 / 环境变量 / 鉴权方式）
# -----------------------------------------------------------------------------
# | provider       | base_url（默认）                                         | 默认模型               | 环境变量             | 鉴权方式      |
# |----------------|---------------------------------------------------------|------------------------|----------------------|---------------|
# | openai_compat  | https://api.openai.com/v1                              | gpt-4o-mini            | OPENAI_API_KEY       | Bearer        |
# | deepseek       | https://api.deepseek.com/v1                          | deepseek-chat          | DEEPSEEK_API_KEY     | Bearer        |
# | qwen           | https://dashscope.aliyuncs.com/compatible-mode/v1     | qwen-plus              | DASHSCOPE_API_KEY    | Bearer        |
# | kimi           | https://api.moonshot.cn/v1                            | moonshot-v1-8k         | MOONSHOT_API_KEY     | Bearer        |
# | glm            | https://open.bigmodel.cn/api/paas/v4                  | glm-4-flash            | ZHIPUAI_API_KEY      | Bearer        |
# | minimax        | https://api.minimax.chat/v1                           | abab6.5s-chat          | MINIMAX_API_KEY      | Bearer        |
# | doubao         | https://ark.cn-beijing.volces.com/api/v3              | doubao-pro-32k         | ARK_API_KEY          | Bearer        |
# | wenxin         | https://qianfan.baidubce.com/v2                       | ernie-4.0-8k           | QIANFAN_API_KEY      | Bearer        |
# | anthropic      | https://api.anthropic.com/v1                          | claude-sonnet-4-20250514 | ANTHROPIC_API_KEY  | x-api-key     |
# | gemini         | https://generativelanguage.googleapis.com/v1beta      | gemini-2.0-flash       | GEMINI_API_KEY       | x-goog-api-key|
# | local_compat   | http://localhost:11434/v1                             | qwen2.5:7b             | （无）               | 无/轻鉴权      |
# | transformers   | 本地 HF 直连（可选依赖，需 pip install transformers）     | Qwen/Qwen2.5-1.5B-Instruct | （无）          | 无            |
# -----------------------------------------------------------------------------
#
# 路由方式（create_adapter）：
#   profile = {"provider": "deepseek", "model": "deepseek-chat"}
#   ad = create_adapter(profile)                # -> OpenAICompatAdapter
#   ad.chat([{"role": "user", "content": "hi"}])
#
# 旧命名兼容：backend="openai_compatible" 自动映射到 provider="openai_compat"；
#             backend="local_mock" 映射到 provider="mock"。
# =============================================================================
