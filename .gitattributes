# 统一换行策略：仓库内文本一律 LF，避免 Windows 提交产生 CRLF 噪声
* text=auto eol=lf

# Windows 专用脚本保留 CRLF，防止 cmd/powershell 解析异常
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制资源：禁止换行转换与文本 diff
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.7z         binary
*.onnx       binary
*.safetensors binary
*.npy        binary
*.pkl        binary

# 基准测试报告由程序生成，按纯文本管理
benchmark/benchmark_report*.txt  text eol=lf
benchmark/benchmark_report*.json text eol=lf

# 抑制 vendored / 生成物在语言统计中的占比
demo/**  linguist-documentation
benchmark/benchmark_report*  linguist-generated
